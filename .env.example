APP_ENV=development
NODE_ENV=development

# Server
ALLOWED_ORIGINS=http://localhost:1313
PORT=1313

# JWT
JWT_SECRET=change_me_please_min32chars________________
JWT_REFRESH_SECRET=change_me_refresh_min32chars________
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:1313/auth/callback

# Supabase (required for persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Socket scaling (Dragonfly/Redis-compatible)
VALKEY_URL=redis://localhost:6379/0

# Token maintenance
SPOTIFY_TOKEN_MAINTENANCE_INTERVAL=60
SPOTIFY_TOKEN_SAFETY_WINDOW=180
